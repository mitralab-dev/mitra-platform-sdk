{
  "name": "@mitralab.io/platform-sdk",
  "version": "1.0.9",
  "description": "JavaScript/TypeScript SDK for building apps on the Mitra Platform",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check:package-types": "npx --yes @arethetypeswrong/cli@0.18.5 --pack .",
    "pack:check": "npm pack --dry-run",
    "smoke:package": "node scripts/smoke-package.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run pack:check && npm run smoke:package",
    "prepublishOnly": "npm run check && npm run check:package-types"
  },
  "keywords": [
    "mitra",
    "sdk",
    "api",
    "crud",
    "authentication",
    "baas",
    "backend-as-a-service"
  ],
  "author": "Mitra Platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mitralab-dev/mitra-platform-sdk"
  },
  "homepage": "https://github.com/mitralab-dev/mitra-platform-sdk#readme",
  "bugs": {
    "url": "https://github.com/mitralab-dev/mitra-platform-sdk/issues"
  },
  "dependencies": {
    "@mitralab.io/sdk-core": "^0.1.0",
    "mitra-interactions-sdk": "1.0.60-beta.42"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.55.0",
    "vite": "~6.4.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "rollup": "^4.59.0",
    "test-exclude": "7.0.1"
  }
}
