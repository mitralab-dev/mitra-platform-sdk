{
  "name": "@mitralab.io/platform-sdk",
  "version": "1.0.7",
  "description": "JavaScript/TypeScript SDK for building apps on the Mitra Platform",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "smoke:package": "node scripts/smoke-package.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run smoke:package",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "mitra",
    "sdk",
    "api",
    "crud",
    "authentication",
    "baas",
    "backend-as-a-service"
  ],
  "author": "Mitra Platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mitralab-dev/mitra-platform-sdk"
  },
  "homepage": "https://github.com/mitralab-dev/mitra-platform-sdk#readme",
  "bugs": {
    "url": "https://github.com/mitralab-dev/mitra-platform-sdk/issues"
  },
  "dependencies": {
    "@mitralab.io/sdk-core": "^0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.0.1",
    "globals": "^16.5.0",
    "tsup": "^8.0.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "rollup": "^4.59.0"
  }
}
